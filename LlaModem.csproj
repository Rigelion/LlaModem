<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LlaModem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
  </ItemGroup>

  <!-- Exclude test files from the main project -->
  <ItemGroup>
    <Compile Remove="LlaModem.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <_ContentIncludedByDefault Remove="LlaModem.Tests\obj\LlaModem.Tests.csproj.nuget.dgspec.json" />
    <_ContentIncludedByDefault Remove="LlaModem.Tests\obj\project.assets.json" />
  </ItemGroup>

</Project>
